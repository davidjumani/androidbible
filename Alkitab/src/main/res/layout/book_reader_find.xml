<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:gravity="center_vertical"
	android:orientation="horizontal">

	<EditText
		android:id="@+id/tFindQuery"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:background="@null"
		android:hint="@string/books_find_hint"
		android:imeOptions="actionSearch|flagNoExtractUi"
		android:importantForAutofill="no"
		android:inputType="text"
		android:maxLines="1"
		android:textColor="#fff"
		android:textColorHint="#b3ffffff"
		android:textSize="18sp" />

	<TextView
		android:id="@+id/tFindCount"
		android:layout_width="wrap_content"
		android:layout_height="40dp"
		android:background="?android:attr/selectableItemBackground"
		android:gravity="center"
		android:minWidth="48dp"
		android:paddingStart="8dp"
		android:paddingEnd="8dp"
		android:textColor="#e6ffffff"
		android:textSize="14sp" />

	<ImageButton
		android:id="@+id/bFindPrev"
		style="?android:attr/borderlessButtonStyle"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:contentDescription="@string/books_find_prev"
		android:src="@drawable/ic_find_prev" />

	<ImageButton
		android:id="@+id/bFindNext"
		style="?android:attr/borderlessButtonStyle"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:contentDescription="@string/books_find_next"
		android:src="@drawable/ic_find_next" />

	<ImageButton
		android:id="@+id/bFindClose"
		style="?android:attr/borderlessButtonStyle"
		android:layout_width="40dp"
		android:layout_height="40dp"
		android:layout_marginEnd="4dp"
		android:contentDescription="@string/books_find_close"
		android:src="@drawable/ic_find_close" />
</LinearLayout>
